# ==============================================================================
# AutoFillForm Studio — Cloudflare Workers + Supabase Environment Template
# Copy sang `.dev.vars` để test local bằng `npm run dev` (Wrangler).
# Khi deploy lên Cloudflare Dashboard, nhập các biến này vào Worker Settings -> Variables & Secrets.
# ==============================================================================

# 1. Supabase (Lấy tại Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9_your_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9_your_service_role_key

# 2. Groq AI Key (Tùy chọn — hệ thống vẫn có key fallback nếu để trống)
GROQ_API_KEY=gsk_your_groq_api_key_here
